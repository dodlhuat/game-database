NUXT_PUBLIC_API_BASE=http://localhost:8000/api

# Stripe Publishable Key (aus dem Stripe Dashboard, Test-Modus liefert einen
# pk_test_... Key) — öffentlich, kein Secret
NUXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Wartungsmodus — true leitet alles auf die Startseite um (zeigt dort die
# Wartungsansicht). In Produktion als Umgebungsvariable des PM2-Prozesses
# setzen und `pm2 restart --update-env`; die .env wird nur im Dev/Build gelesen.
NUXT_PUBLIC_MAINTENANCE_MODE=false
