APP_NAME="Brettspiel-Ausleihplattform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

APP_LOCALE=de
APP_FALLBACK_LOCALE=de
APP_FAKER_LOCALE=de_DE

APP_MAINTENANCE_DRIVER=file
# Gemeinsam mit NUXT_PUBLIC_MAINTENANCE_MODE im Frontend setzen
MAINTENANCE_MODE=false

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=game_database
DB_USERNAME=game_user
DB_PASSWORD=secret

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Queue Worker starten: php artisan queue:work

CACHE_STORE=database

# Sanctum
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
SANCTUM_TOKEN_PREFIX=

# Mail (lokal: Mailpit; Produktion: Resend SMTP)
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Antworten auf Mails landen hier (Absender wie noreply@ hat kein Postfach); leer = kein Reply-To
MAIL_REPLY_TO_ADDRESS=
MAIL_REPLY_TO_NAME="${APP_NAME}"
# Produktion (Resend SMTP): MAIL_HOST=smtp.resend.com, MAIL_PORT=587, MAIL_ENCRYPTION=tls,
# MAIL_USERNAME=resend, MAIL_PASSWORD=<Resend API Key>

# Cloudinary
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

# Address validation (Nominatim / OpenStreetMap) — defaults are fine as-is,
# only override for a paid/self-hosted geocoding instance.
NOMINATIM_BASE_URL=
NOMINATIM_USER_AGENT=

# Mollie (Token-Kauf, Mitgliedsbeitrag) — API-Key aus dem Mollie Dashboard.
# test_... = Testmodus, live_... = echte Zahlungen; der Key allein entscheidet.
MOLLIE_KEY=
# Öffentliche URL des Webhooks (z. B. https://alle-unsere-abenteuer.at/api/webhooks/mollie).
# Lokal leer lassen — Mollie erreicht localhost nicht; die Rückkehr-Seite
# /zahlung fragt den Status dann selbst ab.
MOLLIE_WEBHOOK_URL=
